generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adopters {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String?   @db.Uuid
  name        String
  email       String?
  description String?
  birth_date  DateTime? @db.Date
  avatar_url  String?
  phone       String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches     matches[]
  pets        pets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model matches {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adopter_id       String?   @db.Uuid
  pet_id           String?   @db.Uuid
  interaction_type String
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  adopters         adopters? @relation(fields: [adopter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pets             pets?     @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model medical_records {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pet_id          String?        @db.Uuid
  vet_employee_id String?        @db.Uuid
  visit_date      DateTime?      @default(dbgenerated("CURRENT_DATE")) @db.Date
  vaccines        String?
  notes           String?
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  pets            pets?          @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vet_employees   vet_employees? @relation(fields: [vet_employee_id], references: [id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pets {
  id                    String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String
  species               String
  breed                 String?
  birth_date            DateTime?          @db.Date
  registration_date     DateTime?          @default(dbgenerated("CURRENT_DATE")) @db.Date
  description           String?
  image_url             String?
  status                String?            @default("disponible")
  shelter_id            String?            @db.Uuid
  in_charge_employee_id String?            @db.Uuid
  adopter_id            String?            @db.Uuid
  created_at            DateTime?          @default(now()) @db.Timestamptz(6)
  matches               matches[]
  medical_records       medical_records[]
  adopters              adopters?          @relation(fields: [adopter_id], references: [id], onUpdate: NoAction)
  shelter_employees     shelter_employees? @relation(fields: [in_charge_employee_id], references: [id], onUpdate: NoAction)
  shelters              shelters?          @relation(fields: [shelter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shelter_employees {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shelter_id String?   @db.Uuid
  name       String
  phone      String?
  email      String?
  birth_date DateTime? @db.Date
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  pets       pets[]
  shelters   shelters? @relation(fields: [shelter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shelters {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String?             @db.Uuid
  name              String
  email             String?
  location          String?
  phone             String?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  pets              pets[]
  shelter_employees shelter_employees[]
  users             users?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String        @unique
  password_hash String
  role          String
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  adopters      adopters[]
  shelters      shelters[]
  vet_clinics   vet_clinics[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vet_clinics {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String?         @db.Uuid
  name          String
  email         String?
  location      String?
  phone         String?
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  users         users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vet_employees vet_employees[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vet_employees {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vet_clinic_id   String?           @db.Uuid
  name            String
  phone           String?
  email           String?
  birth_date      DateTime?         @db.Date
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  medical_records medical_records[]
  vet_clinics     vet_clinics?      @relation(fields: [vet_clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
